# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/your_db"

# Google Gemini (free tier) — used only by the Reference Architecture Generator
GEMINI_API_KEY="insert_your_api_key_here"
GEMINI_MODEL=gemini-2.0-flash

# Ollama — runs locally, all secondary reasoning steps
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# Crawler settings
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_CONCURRENT=10
CRAWLER_TIMEOUT_SECONDS=30

# Domains to run --all against. Leave blank for none, or use a JSON list:
#   PIPELINE_DOMAINS=["securin.io", "example.com"]
# A comma-separated list (securin.io,example.com) is also accepted.
PIPELINE_DOMAINS=

# Observability (optional — leave blank to disable OTLP export)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=aeo-pipeline
LOG_LEVEL=INFO
