# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:Sanjith29@localhost:5432/aeo_saas

# Google Gemini (free tier) — used only by the Reference Architecture Generator
GEMINI_API_KEY=AQ.Ab8RN6IlLVBImgfBpoxb1B6R_PMgw52I0MQ6QADoaHLbt-idMA
GEMINI_MODEL=gemini-2.0-flash

# Ollama — runs locally, all secondary reasoning steps
OLLAMA_BASE_URL=http://localhost:11434
