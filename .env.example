# Crawler settings
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_CONCURRENT=10
CRAWLER_TIMEOUT_SECONDS=30

# Domains to run --all against. Leave blank for none, or use a JSON list:
#   PIPELINE_DOMAINS=["securin.io", "example.com"]
# A comma-separated list (securin.io,example.com) is also accepted.
PIPELINE_DOMAINS=

# Observability (optional — leave blank to disable OTLP export)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=aeo-pipeline
LOG_LEVEL=INFO
