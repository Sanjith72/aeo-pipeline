# PostgreSQL connection string
DATABASE_URL=postgresql://aeo:secret@localhost:5432/aeo

# Google Gemini (free tier) — used only by the Reference Architecture Generator
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Ollama — runs locally, all secondary reasoning steps
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3

# Crawler settings
CRAWLER_MAX_PAGES=200
CRAWLER_MAX_CONCURRENT=10
CRAWLER_TIMEOUT_SECONDS=30

# Comma-separated list of domains to run --all against
PIPELINE_DOMAINS=example.com,yoursite.com

# Observability (optional — leave blank to disable OTLP export)
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=aeo-pipeline
LOG_LEVEL=INFO
