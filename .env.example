# =============================================================
# AEO Crawler — environment template. Copy to .env and fill in.
# Never commit a real .env — secrets (DB password, API keys) live here only.
#
# Naming rule: every Settings field is read with the AEO__ prefix and __ as the
# nesting delimiter (e.g. llm.model -> AEO__LLM__MODEL). The ONLY unprefixed
# vars are DATABASE_URL / DB_POOL_* (read directly by settings.py).
# =============================================================

# --- Database (required) ---------------------------------------
# Local dev default. For Supabase (free tier), use the SESSION pooler — note the
# dot-suffixed username and the pooler host (the direct db.<ref>.supabase.co host is
# IPv6-only on the free plan); keep ?sslmode=require (the URL reaches libpq verbatim):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://aeo:aeo@localhost:5432/aeo
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Config files ----------------------------------------------
# Directory holding the *.yaml rubric/extractor config. Defaults to <repo>/config
# for a source checkout. MUST be set for an installed wheel / container, because
# config/ is not bundled into the wheel.
# AEO__CONFIG_DIR=/app/config

# --- Crawler (overrides config/crawler.yaml) -------------------
AEO__CRAWLER__USER_AGENT="AEOBot/0.2 (+https://securin.io/bot)"
AEO__CRAWLER__CONCURRENCY=4
AEO__CRAWLER__REQUEST_TIMEOUT_SEC=30
AEO__CRAWLER__RESPECT_ROBOTS=true

# --- LLM -------------------------------------------------------
# enabled=false -> all scorers run deterministic-only (content_depth & stats lose
# LLM refinement but still score). No LLM process/key needed when disabled.
AEO__LLM__ENABLED=true
# provider picks the backend:
#   "hybrid" (prod default for the $0 stack) — the Gemini+Qwen router: reasoning-profile
#            calls run Gemini first, fast/bulk calls run Qwen first; 429/5xx retry with
#            backoff, in-family then cross-family failover, malformed-JSON healing by
#            the other provider.
#   "gemini" | "qwen" — pin one native provider (same retry policy, no failover).
#   "ollama" (local, free — dev) or "cloud" (one OpenAI-compatible endpoint, legacy).
AEO__LLM__PROVIDER=ollama
# Ollama (local) backend
AEO__LLM__HOST=http://localhost:11434
AEO__LLM__MODEL=qwen2.5:3b
# Hybrid: Gemini side. Create the AI Studio key in a Google Cloud project with NO
# billing attached (attaching billing ends free-tier usage). Free quota (2026-07):
# gemini-2.5-flash ~10 RPM / 250 req/day; flash-lite ~15 RPM / 1000 req/day.
# AEO__LLM__GEMINI_API_KEY=    # secret — https://aistudio.google.com/apikey
# AEO__LLM__GEMINI_MODEL=gemini-2.5-flash
# AEO__LLM__GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Hybrid: Qwen side. Primary = Groq's free plan (no card): qwen3-32b at 60 RPM /
# 1000 req/day / 6K tokens-per-minute — keep prompts short. Optional fallback =
# OpenRouter ':free' (20 RPM / 50 req/day at strictly $0). ':free' ids churn — if
# OpenRouter 404s, pick a live one from https://openrouter.ai/api/v1/models.
# AEO__LLM__QWEN_API_KEY=              # secret — https://console.groq.com
# AEO__LLM__QWEN_MODEL=qwen/qwen3-32b
# AEO__LLM__QWEN_FALLBACK_API_KEY=     # secret — https://openrouter.ai/keys
# AEO__LLM__QWEN_FALLBACK_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# Retry/failover policy for the gemini/qwen/hybrid backends.
# AEO__LLM__RETRY_MAX_ATTEMPTS=3
# AEO__LLM__RETRY_MAX_BACKOFF_SEC=8
# AEO__LLM__FAILOVER_ENABLED=true
# Embeddings for pgvector semantic search (migration 0025); served by Gemini's free
# embeddings surface at 768 dims. No key -> semantic search degrades to keyword.
# AEO__LLM__EMBEDDING_MODEL=gemini-embedding-001
# Index audited pages into content_embeddings during deep audits (one embeddings call
# per changed page — real quota on the free tiers, so opt-in).
# AEO__LLM__EMBEDDING_INDEXING=false
# Legacy cloud backend — any OpenAI-compatible endpoint (Gemini compat, OpenAI, Together…)
# AEO__LLM__CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AEO__LLM__CLOUD_MODEL=gemini-2.5-flash
# AEO__LLM__CLOUD_API_KEY=     # secret — set only in the real .env, never commit
AEO__LLM__TIMEOUT_SEC=120
# Foreground (latency-sensitive) LLM work — fail-fast, independent of TIMEOUT_SEC (the
# bulk/audit budget). The synchronous /api/plan call and the polled
# /api/deliverables/personalize build use INTERACTIVE_TIMEOUT_SEC as a short, no-retry per-call
# timeout, so a slow/hung local model degrades to deterministic output in bounded time instead
# of making a user wait minutes. The page-DRAFT fan-out gets two more bounds on top: it runs
# across DRAFT_CONCURRENCY workers, capped by DRAFT_PHASE_BUDGET_SEC total wall-clock (remaining
# pages then fall back to the deterministic scaffold instead of each waiting out its timeout).
AEO__LLM__INTERACTIVE_TIMEOUT_SEC=45
AEO__LLM__DRAFT_CONCURRENCY=4
AEO__LLM__DRAFT_PHASE_BUDGET_SEC=180
# Hybrid reasoning tier (Phase 2 agents): the Planner/Builder/Critic route their frontier
# calls to PLANNING_PROVIDER (e.g. "cloud") while the fast sync endpoints + bulk audit stay on
# PROVIDER. Empty = use the primary PROVIDER (no separate frontier tier).
AEO__LLM__PLANNING_PROVIDER=

# --- Agent runtime (Phase 2: assistive copilot, drained by the `worker` service) --
# Scoped LLM agents driven by a deterministic controller on the existing Postgres job queue
# (no new broker). Every step has a deterministic floor, so disabling an agent only skips its
# LLM work — a run still stages for human approval. Nothing publishes unreviewed.
AEO__AGENTS__CONCURRENCY=2            # AGENT_RUN jobs a worker drains at once
AEO__AGENTS__STEP_TIMEOUT_SEC=120    # per-step bound (enforced per-LLM-call)
AEO__AGENTS__MAX_ATTEMPTS=3          # per-run retry budget before a run is marked failed
# Orchestration mode: "react" = the agentic loop (the LLM plans its own steps over the
# tool registry, self-corrects on observations, stages when ready; falls back to the
# ladder automatically when no LLM is available). "ladder" = fixed research->plan->
# build->critic sequence.
AEO__AGENTS__MODE=react
AEO__AGENTS__REACT_MAX_STEPS=12      # step budget for one agentic run
AEO__AGENTS__RESEARCH_ENABLED=true   # discover + live-verify competitors before planning
AEO__AGENTS__BUILD_ENABLED=true      # draft staged page copy after planning
AEO__AGENTS__DRAFT_LIMIT=5           # cap drafts per run (the dominant frontier cost)
AEO__AGENTS__CRITIC_ENABLED=true     # gate staged drafts (independent + adversarial + claim audit)

# --- PageSpeed Insights (optional, criterion 8) ----------------
# Without a key, load_speed scores a neutral 3 (never punitive).
# Get a key: https://developers.google.com/speed/docs/insights/v5/get-started
# AEO__PSI_API_KEY=

# --- HTTP API (SP-4, `aeo serve`) ------------------------------
# Optional key: when set, every /api/* route except /api/health requires a
# matching X-API-Key header. The web UI's server-side proxy injects it — set the
# SAME value as API_KEY on the web host (never NEXT_PUBLIC_*, nothing ships to
# the browser).
# AEO__API__AUTH_KEY=
# ADMIN credential (X-Admin-Key) for routes that MINT entitlements (/api/entitlements/grant).
# MUST differ from AEO__API__AUTH_KEY: the web app's proxy injects that key into every /api/*
# request it forwards, so every visitor's browser effectively holds it — it authenticates the
# proxy, not the person. Unset while AUTH_KEY is set → those routes are DISABLED (fail closed).
# AEO__API__ADMIN_KEY=
# Browser origins allowed to call the API (the web UI is a different origin).
# Comma-separated. Defaults to the local dev UI on port 3000.
# AEO__API__CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- User auth + pack gating (v5 CH-07/CH-02a) -----------------
# A SEPARATE boundary from AEO__API__AUTH_KEY above: that key authenticates the web
# proxy as a service, this authenticates an END USER and is what makes the pack /
# ticket gate real (locked pack detail → 403, tickets filtered to unlocked packs).
#
# UNSET = NO GATING. With neither value set, auth degrades to open/dev: every caller
# is anonymous, and pack-detail routes fall back to a dev user. Set this together with
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY on the web host — one side
# alone means tokens are issued but never verified (or vice versa).
#
# Pick ONE verification mode (both is fine only while rotating keys):
#
#  (a) Shared secret — Supabase dashboard → Project Settings → API → JWT Secret.
#      Only exists on projects using the legacy HS256 secret. Treat as a signing key.
# AEO__AUTH__JWT_SECRET=
#
#  (b) JWKS / asymmetric (ES256) — the default for Supabase projects created with JWT
#      signing keys, which have NO shared secret at all. Public keys only; the private
#      key never leaves Supabase. If logins fail with "invalid token" while the secret
#      is set, your project is asymmetric — use this instead.
# AEO__AUTH__JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# Optional: pin the issuer so a token minted for another project is rejected.
# AEO__AUTH__JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Comma-separated promo codes that redeem to an all_packs grant. Works with or without
# Stripe below — the manual/promo path is never removed. Empty → redemption disabled.
# AEO__AUTH__PROMO_CODES=

# --- Payments: Stripe Checkout (v5 CH-02b) ---------------------
# Pricing model = FLAT PRICE PER PACK (§9.2 resolved). Buying one pack grants exactly
# scope='pack', pack_index=N — the same entitlement a promo/manual grant produces, so
# payment is only a new SOURCE, not a new access model. No migration needed.
#
# Unset → the buy button 503s and the UI hides it; promo codes and manual grants still
# work, so an unconfigured deployment degrades to the documented stub.
#
# Stripe dashboard → Developers → API keys. SECRET key (sk_live_… / sk_test_…).
# Never NEXT_PUBLIC_*: this must not reach the browser.
# AEO__PAYMENTS__STRIPE_SECRET_KEY=
#
# Stripe dashboard → Developers → Webhooks → add endpoint:
#   URL:    https://<your-api-host>/api/webhooks/stripe
#   Events: checkout.session.completed
#           checkout.session.async_payment_succeeded
# BOTH events are required. Cards settle instantly and arrive on the first; delayed methods
# (ACH/SEPA/Bacs) arrive UNPAID on the first and pay later on the second — subscribe to only
# one and those customers pay and never receive the pack, silently.
# Then copy that endpoint's signing secret (whsec_…). This is the ONLY credential on the
# webhook route — it is exempt from AEO__API__AUTH_KEY because Stripe cannot send it.
# Setting the secret key WITHOUT this is now a fatal startup error: it would take money it
# could never deliver against.
# AEO__PAYMENTS__WEBHOOK_SECRET=
#
# The PUBLIC web-app origin Stripe returns the buyer to. REQUIRED in any split deployment:
# the web proxy rewrites Host, so the backend cannot infer it and would redirect the paying
# customer to the API's own /studio, which does not exist (404 after payment).
# AEO__PAYMENTS__PUBLIC_APP_URL=https://your-app.vercel.app
#
# Price for ONE pack, in the currency's minor unit (4900 = $49.00).
# AEO__PAYMENTS__PACK_PRICE_CENTS=4900
# AEO__PAYMENTS__CURRENCY=usd
# Optional: use a dashboard-managed Price instead (handles tax/multi-currency).
# AEO__PAYMENTS__STRIPE_PRICE_ID=
#
# Local testing without a public URL:  stripe listen --forward-to localhost:8000/api/webhooks/stripe
# (that prints its own whsec_… — use it for WEBHOOK_SECRET while testing)

# --- Docker Compose only (ignored by native runs) --------------
# Host port the bundled Postgres publishes on (change when the host already
# runs Postgres on 5432; containers always use the internal network).
# POSTGRES_HOST_PORT=5432
# LLM endpoint the containerized API uses. Default is the `--profile llm`
# ollama container; point at http://host.docker.internal:11434 to reuse an
# Ollama already running on the host machine.
# DOCKER_LLM_HOST=http://ollama:11434

# --- Logging ---------------------------------------------------
AEO__LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
AEO__LOG_FORMAT=json         # json (prod) | console (dev, colour)

# =============================================================
# v4 — Reference Architecture, Independent Validator, infra
# =============================================================

# --- Reference Architecture Generator --------------------------
# The versioned, per-topic ideal-site blueprint. Synthesis uses the LLM above:
# point it at Gemini's OpenAI-compatible endpoint (provider=cloud) for the L3
# layer; falls back to the deterministic builder when the LLM is off/fails.
AEO__REFERENCE_ARCHITECTURE__ENABLED=true
AEO__REFERENCE_ARCHITECTURE__TOPIC=PEV
AEO__REFERENCE_ARCHITECTURE__FRAMEWORK_VERSION=1
AEO__REFERENCE_ARCHITECTURE__MIN_PAGES_PER_CLUSTER=10
AEO__REFERENCE_ARCHITECTURE__REGENERATE_CADENCE_DAYS=30
# Default answer-engine to optimize toward (routes the synthesis prompt emphasis):
#   perplexity | chatgpt_search | gemini | generic
AEO__REFERENCE_ARCHITECTURE__ENGINE_TARGET=generic
# Per-domain onboarding: drop a config/domains/<domain>.yaml (e.g. securin.io.yaml)
# to override topic / engine_target / max_urls / label per client — no env change.
# Preview any domain with NO DB writes:  aeo audit <domain> --dry-run
# To use Gemini for synthesis (recommended in prod):
#   AEO__LLM__ENABLED=true
#   AEO__LLM__PROVIDER=cloud
#   AEO__LLM__CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AEO__LLM__CLOUD_MODEL=gemini-2.5-flash
#   AEO__LLM__CLOUD_API_KEY=        # secret — Gemini API key

# --- Independent Validator (Perplexity citation test) ----------
# v4 fixes circular validation: independent deterministic checks always run;
# the Perplexity real-world citation test runs only when enabled + keyed.
AEO__VALIDATION__INDEPENDENT_ENABLED=true
AEO__VALIDATION__ANALYSIS_CONCURRENCY=1   # >1 fans out the per-page analysis loop
AEO__PERPLEXITY__ENABLED=false
# AEO__PERPLEXITY__API_KEY=               # secret — Perplexity API key
AEO__PERPLEXITY__MODEL=sonar

# --- Parallel Processor ----------------------------------------
# Run the criterion scorers concurrently (identical output; win on LLM criteria).
AEO__SCORING__PARALLEL=false
AEO__SCORING__MAX_WORKERS=8

# --- Observability (optional OpenTelemetry) --------------------
# The agent_traces table + `aeo trace` are always on (queryable per-page journey).
# This adds OPTIONAL OTLP export alongside it for a collector (Tempo/Jaeger/
# Honeycomb). No-op unless enabled AND the SDK is installed: pip install -e ".[otel]".
AEO__OBS__OTEL_ENABLED=false
# AEO__OBS__OTEL_ENDPOINT=http://localhost:4317   # OTLP gRPC endpoint
AEO__OBS__OTEL_SERVICE_NAME=aeo

# --- Infra (OCI Ampere / ARM) ----------------------------------
# Force IPv4 on outbound HTTP — stops silent scraper stalls on Ampere's
# dual-stack resolver. Leave false on dev / most clouds.
AEO__CRAWLER__FORCE_IPV4=false
