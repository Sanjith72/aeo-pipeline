# Every dotenv variant, not just the bare name: `.env` alone left .env.local /
# .env.production committable, and those now hold the Stripe + Supabase credentials.
# The negation keeps the tracked template tracked. (Mirrors root .dockerignore.)
.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.idea/
.vscode/
*.log
ops/data/
.DS_Store
.claude/
.superpowers/

# local tooling + scratch/test artifacts (not for the shared repo)
.obsidian/
dchk/
/reports/
.mcp.json
/apple_report.pdf
/apple-site-report.pdf
/config/domains/apple.com.yaml

# Supabase CLI local link state
/supabase/.temp/
