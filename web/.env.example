# Base URL of the AEO HTTP API (SP-4a). Start it with `aeo serve` (default port 8000).
# Copy to .env.local and adjust if your API runs elsewhere.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional API key. Set this to match the backend's AEO__API__AUTH_KEY when the API runs
# with auth enabled; the client then sends it as the X-API-Key header. Leave blank in dev.
NEXT_PUBLIC_API_KEY=
