# Server-side API proxy config (read by app/api/[...path]/route.ts at request time).
# The browser only ever calls this app (same-origin); the proxy forwards to the backend and
# injects the key — so neither value ships to the browser. Copy to .env.local for `npm run dev`.

# Backend API origin. `aeo serve` defaults to port 8000. In docker-compose it's http://api:8000.
API_BASE_URL=http://localhost:8000

# Forwarded as X-API-Key. Set this to match the backend's AEO__API__AUTH_KEY when the API runs
# with auth enabled. Leave blank in local dev (the API runs open).
API_KEY=

# --- User auth + pack gating (v5 CH-07/CH-02a) -----------------------------------------
# UNSET = NO GATING. With these blank, `authEnabled` is false: no Sign-in button, no auth
# modal, and every visitor stays anonymous (Pack 1 only, deeper packs locked for everyone
# with no way to unlock). Set BOTH here AND AEO__AUTH__JWT_SECRET (or AEO__AUTH__JWKS_URL)
# on the backend — configuring only one side means tokens are issued but never verified.
# Both values are public by design and safe to ship in the browser bundle.
# Supabase dashboard → Project Settings → API.
# The PROJECT URL (https://<ref>.supabase.co) — not the dashboard address.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# To enable "Continue with Google", in the Supabase dashboard:
#   1. Authentication → Providers → Google → enable, and paste the Client ID + Secret from a
#      Google Cloud OAuth 2.0 Web client (console.cloud.google.com → APIs & Services →
#      Credentials).
#   2. In that Google client, add Supabase's callback as an Authorized redirect URI:
#      https://<project-ref>.supabase.co/auth/v1/callback
#   3. Authentication → URL Configuration → Site URL = this app's origin, and add
#      <origin>/auth/callback to Redirect URLs (add http://localhost:3000/auth/callback too
#      for local dev). This app always returns to /auth/callback.
# No extra env var is needed here — Google is configured entirely in Supabase.
